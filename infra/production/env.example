KIBOTALK_API_IMAGE=kibotalk-api:replace-with-release-sha
POSTGRES_PASSWORD=generate-a-long-random-value
AUTH_SECRET=generate-a-long-random-value
SYNC_ENCRYPTION_KEY=generate-32-random-bytes-as-base64
ADMIN_EMAILS=admin@example.com

RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=noreply@kibotalk.app
RESEND_FROM_NAME=Kibo Ai

STT_ACTIVE=dashscope-realtime
STT_DASHSCOPE_API_KEY=sk-xxxxxxxxx
STT_DASHSCOPE_WS_URL=wss://YOUR_WORKSPACE.ap-northeast-1.maas.aliyuncs.com/api-ws/v1/realtime
STT_DASHSCOPE_REALTIME_MODEL=qwen3-asr-flash-realtime

LLM_ACTIVE=openai
LLM_THINKING=disabled
LLM_OPENAI_BASE_URL=https://api.deepseek.com
LLM_OPENAI_API_KEY=sk-xxxxxxxxx
LLM_OPENAI_MODEL=deepseek-v4-flash

APP_VERSION=0.1.0
APP_DMG_URL=https://github.com/KiboAI/KiboTalk/releases
APP_RELEASE_NOTES_URL=https://github.com/KiboAI/KiboTalk/releases

SERVER_ROLE=primary
RELAY_NODE_ID=jp-primary
RELAY_PRIMARY_ORIGIN=https://app.kibotalk.app
RELAY_NODES_JSON=[]
