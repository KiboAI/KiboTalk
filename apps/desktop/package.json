{
  "name": "@kibotalk/desktop",
  "version": "0.1.0",
  "description": "KiboTalk live reply assistant for Apple Silicon Macs",
  "author": "KiboTalk",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -p tsconfig.json --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "download-models": "tsx scripts/download-models.ts",
    "verify:q8": "tsx scripts/verify-q8-speaker.ts",
    "package:mac": "pnpm download-models && pnpm build && electron-builder --config electron-builder.config.ts --mac --arm64"
  },
  "dependencies": {
    "@kibotalk/app-shared": "workspace:*",
    "@kibotalk/conversation": "workspace:*",
    "@kibotalk/pages": "workspace:*",
    "@kibotalk/speaker": "workspace:*",
    "@kibotalk/ui": "workspace:*",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "lucide-react": "^1.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
