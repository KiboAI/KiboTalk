# KiboTalk 后端代理环境变量
# 复制本文件为 .env（仓库根目录），填入真实 key。.env 已被 gitignore。
# 仅 apps/api 读取这些变量；key 不会离开后端进程，浏览器拿不到。
#
# 启动顺序：
#   1) pnpm dev:api          # 读 .env，监听 http://localhost:8787（含 WS /stt-realtime）
#   2) pnpm dev:playground    # Vite 把 /stt-realtime /llm 代理到 8787

# ── 代理端口 ─────────────────────────────────────────────
PORT=8787

# ── 生产节点拓扑 ─────────────────────────────────────────
# 日本主服务器（当前生产只有这一台）：
# SERVER_ROLE=primary
# RELAY_NODE_ID=jp-primary
# RELAY_PRIMARY_ORIGIN=https://app.kibotalk.app
# RELAY_NODES_JSON=[]
#
# 可选中转服务器（例如香港或新加坡）：
# SERVER_ROLE=relay
# RELAY_NODE_ID=sg-relay
# RELAY_PRIMARY_ORIGIN=https://app.kibotalk.app
# RELAY_OUTBOX_PATH=/app/data/usage-outbox.json
# RELAY_ACCEPT_NEW_SESSIONS=true
# 主服务器用 JSON 发布一个或多个中转节点：
# RELAY_NODES_JSON=[{"id":"sg-relay","origin":"https://sg-relay.kibotalk.app"}]
#
# Ed25519：主服务器保存私钥，所有节点保存公钥。值可以是 PEM，或 PEM 的 base64。
# RELAY_TOKEN_PRIVATE_KEY=replace-on-primary-only
# RELAY_TOKEN_PUBLIC_KEY=replace-on-all-nodes
# 节点间心跳和用量回传凭据（与用户/提供商密钥分离）：
# RELAY_NODE_SECRET=replace-with-a-long-random-secret

# Playground 启动时选择后端；不支持页面运行中切换。
# 默认：http://localhost:8787
# 生产：https://app.kibotalk.app
# 自定义：任意 KiboTalk API origin
# PLAYGROUND_API_ORIGIN=http://localhost:8787

# ── 语音转写 (STT) ────────────────────────────────────────
# Realtime only（WS /stt-realtime?provider=dashscope-realtime，ADR 0004）。
# 浏览器只连同源代理，不直连上游。
STT_ACTIVE=dashscope-realtime
STT_DASHSCOPE_API_KEY=sk-xxxxxxxx
STT_DASHSCOPE_WS_URL=wss://{WorkspaceId}.ap-northeast-1.maas.aliyuncs.com/api-ws/v1/realtime
STT_DASHSCOPE_REALTIME_MODEL=qwen3-asr-flash-realtime

# ── 大语言模型 (LLM) ─────────────────────────────────────
# 走 xsai（OpenAI 兼容）。provider 与 STT 可不同。
# 已注册：openrouter、openai（本地 LM Studio 等 OpenAI 兼容端点）。
# 模型示例：deepseek-v4-flash、deepseek/deepseek-chat 等。
# DeepSeek V4 默认开 thinking，会把「首 content」拖到 20s+；实时教练默认关。
# 需要思维链时设 LLM_THINKING=enabled。
LLM_THINKING=disabled
LLM_ACTIVE=openrouter
LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
LLM_OPENROUTER_MODEL=deepseek/deepseek-chat

# 直连 DeepSeek API（OpenAI 兼容）：
# LLM_ACTIVE=openai
# LLM_OPENAI_BASE_URL=https://api.deepseek.com
# LLM_OPENAI_API_KEY=sk-xxxxxxxx
# LLM_OPENAI_MODEL=deepseek-v4-flash

# 本地 LM Studio（Developer → Local Server，默认 :1234，OpenAI-compatible）：
# 需 apps/api 与 LM Studio 同机。鉴权关闭时 API_KEY 填任意非空占位即可。
# LLM_ACTIVE=openai
# LLM_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# LLM_OPENAI_API_KEY=lm-studio
# LLM_OPENAI_MODEL=google/gemma-4-e4b

# ── 比赛生产账号、同步与发布 ─────────────────────────────
# 本地开发可不配置 DATABASE_URL；生产必须设置数据库、认证和同步密钥。
# SYNC_ENCRYPTION_KEY 为 32 bytes base64（例如 `openssl rand -base64 32`）。
# 管理员邮箱可逗号分隔。RESEND_FROM_EMAIL 对开放注册必须使用已验证域名。
DATABASE_URL=postgres://kibotalk:password@localhost:5432/kibotalk
AUTH_SECRET=replace-with-a-long-random-secret
SYNC_ENCRYPTION_KEY=replace-with-32-byte-base64
ADMIN_EMAILS=admin@example.com
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=noreply@kibotalk.app
RESEND_FROM_NAME="Kibo Ai"

APP_VERSION=0.1.0
APP_DMG_URL=https://github.com/KiboAI/KiboTalk/releases
APP_RELEASE_NOTES_URL=https://github.com/KiboAI/KiboTalk/releases
